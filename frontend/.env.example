# ---------- Next.js frontend ----------
# Server-side URL used by the Next.js route handlers (inside the container
# network this is "http://api:8000"; locally it's "http://localhost:8000").
BACKEND_URL=http://localhost:8000

# Public URL exposed to the browser. Usually the same as BACKEND_URL but the
# hostname must be reachable from the user's browser, not from the container.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
